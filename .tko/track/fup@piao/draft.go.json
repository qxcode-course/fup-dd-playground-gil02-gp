            "content": "package main\n\nimport \"fmt\"\n\nfunc abs(x int) int {\n\tif x < 0 {\n\t\treturn -x\n\t}\n\treturn x\n}\nfunc main() {\n\tvar l, n int\n\tfmt.Scan(&l)\n\tfmt.Scan(&n)\n\n\tganhador := -1\n\tmelhor := l + 1\n\tperdedor := 0\n\tpior := -1\n\n\tfor i := 0; i < n; i++ {\n\t\tvar jogada int\n\t\tfmt.Scan(&jogada)\n\t\tdista := abs(jogada)\n\n\t\tif dista <= l && dista <= melhor {\n                melhor = dista\n                ganhador = i\n\t\t}\n        \n\t\tif dista >= pior {\n                pior = dista\n                perdedor = i\n        }\n\t}\n\n\tif ganhador == -1 {\n\t\tfmt.Println(\"nenhum\")\n\t} else {\n\t\tfmt.Println(ganhador)\n\t}\n\n\tfmt.Println(perdedor)\n}\n",
