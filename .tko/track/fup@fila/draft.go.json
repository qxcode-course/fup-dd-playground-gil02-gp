            "content": "package main\nimport \"fmt\"\nfunc main() {\n    var n int\n    fmt.Scan(&n)\n    var aluno[50] int\n    var servidores[50] int\n    cont_alu := 0\n    cont_ser := 0\n \n    for i := 0; i < n; i++ {\n        var tipo int\n        fmt.Scan(&tipo)\n        if tipo % 2 == 1 {\n            aluno[cont_alu] = tipo\n            cont_alu++\n        } else {\n            servidores[cont_ser] = tipo\n            cont_ser++\n        }\n    }\n    fmt.Print(\"[\")\n    for i := 0; i < cont_alu; i++ {\n        fmt.Print(\" \", aluno[i])\n    }\n    fmt.Print(\" ]\\n\")\n\n    fmt.Print(\"[\")\n    for i := 0; i < cont_ser; i++ {\n        fmt.Print(\" \", servidores[i])\n    }\n    fmt.Print(\" ]\\n\")\n}\n",
